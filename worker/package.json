{
  "name": "lavoz-worker",
  "version": "1.0.0",
  "description": "Worker de procesamiento de audio para La Voz de la Verdad",
  "main": "main.js",
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --outfile=dist/main.js --format=cjs",
    "build:release": "pnpm run build && node scripts/zip-dist.js",
    "release": "pnpm run build:release",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "axios": "^1.18.0",
    "dotenv": "^16.4.5",
    "form-data": "^4.0.0",
    "semver": "^7.6.3",
    "unzipper": "^0.12.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "@types/semver": "^7.5.8",
    "@types/unzipper": "^0.10.9",
    "@types/ws": "^8.18.1",
    "archiver": "^7.0.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  }
}
